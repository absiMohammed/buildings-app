# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Mongo
MONGO_URI=mongodb://localhost:27017/building-app

# Auth
JWT_ACCESS_SECRET=replace-me-with-long-random-string
JWT_REFRESH_SECRET=replace-me-with-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_COST=12

# Email (Resend by default; SendGrid/SES also fine)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Building App <noreply@example.com>"

# File storage (local in dev; S3 later)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Building bootstrap (used by seed script)
SEED_BUILDING_NAME="My Building"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!123
SEED_ADMIN_FIRST=Admin
SEED_ADMIN_LAST=User
