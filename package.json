{
  "name": "building-app",
  "version": "0.1.0",
  "private": true,
  "description": "Residential building management app (MERN)",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace server run build && npm --workspace client run build",
    "start": "npm --workspace server run start",
    "lint": "npm-run-all --parallel lint:*",
    "lint:server": "npm --workspace server run lint",
    "lint:client": "npm --workspace client run lint",
    "test": "npm --workspace server run test"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
